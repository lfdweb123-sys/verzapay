rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────────────────────────────
    // Utilisateurs
    // ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Création : jamais admin, jamais vérifié (champs posés par le serveur uniquement)
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('isAdmin', false) == false
        && !request.resource.data.keys().hasAny([
          'emailCodeVerified', 'emailCodeVerifiedAt', 'verifyRequestedAt', 'verifyDeadline',
          'disabled', 'deleted'
        ]);

      // Mise à jour : liste blanche des champs que l'utilisateur peut modifier lui-même.
      // isAdmin, emailCodeVerified, disabled, email... ne passent que par le serveur (Admin SDK).
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'theme', 'themeMode', 'currency', 'activeCompanyId',
          'fcmTokens', 'twoFactorEnabled', 'transactionTwoFactorEnabled'
        ]);

      allow delete: if false;
    }

    // ───────────────────────────────────────────────
    // Entreprises
    // ───────────────────────────────────────────────
    match /companies/{companyId} {
      allow read: if request.auth != null &&
        resource.data.members.hasAny([request.auth.uid]);

      // Mise à jour client : liste blanche (webhook + frais à charge). Tout le reste
      // (walletBalance, kycStatus, suspended, members, ownerUid, legalInfo, clés API...)
      // est écrit uniquement par les routes API serveur (Admin SDK), qui contournent ces règles.
      allow update: if request.auth != null
        && resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['webhookUrl', 'feesCollection', 'feesPayout'])
        && (!('feesCollection' in request.resource.data)
            || request.resource.data.feesCollection in ['MERCHANT', 'CUSTOMER'])
        && (!('feesPayout' in request.resource.data)
            || request.resource.data.feesPayout in ['MERCHANT', 'CUSTOMER']);

      allow create: if false; // uniquement via /api/companies/create (Admin SDK)
      allow delete: if false;

      // Transactions : lecture par les membres, écriture interdite côté client
      match /transactions/{txId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.members.hasAny([request.auth.uid]);
        allow write: if false;
      }

      // Décaissements : lecture par les membres, écriture interdite côté client
      match /payouts/{poId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.members.hasAny([request.auth.uid]);
        allow write: if false;
      }

      // Journal comptable (ledger) : lecture seule
      match /ledger/{entryId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.members.hasAny([request.auth.uid]);
        allow write: if false;
      }

      // Invitations d'équipe : lecture par les membres, écriture interdite
      // côté client (passe par /api/team/invite et /api/team/respond)
      match /invites/{inviteId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.members.hasAny([request.auth.uid]);
        allow delete: if request.auth != null &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid;
        allow write: if false;
      }

      // Logs webhook — lecture membres, écriture Admin SDK uniquement
      match /webhookLogs/{logId} {
        allow read: if request.auth != null &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.members.hasAny([request.auth.uid]);
        allow write: if false;
      }
    }

    // ───────────────────────────────────────────────
    // Notifications in-app
    // ───────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      // Seul le champ "read" peut être modifié par le propriétaire (marquer comme lu)
      allow update: if request.auth != null && resource.data.uid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      // Le propriétaire peut supprimer sa propre notification (unitaire ou en masse)
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if false;
    }

    // ───────────────────────────────────────────────
    // Codes 2FA — jamais accessibles côté client
    // ───────────────────────────────────────────────
    match /twoFactorCodes/{uid} {
      allow read, write: if false; // uniquement /api/auth/2fa/* (Admin SDK)
    }

    // ───────────────────────────────────────────────
    // Messages de contact/support — écriture uniquement via API (anti-spam)
    // ───────────────────────────────────────────────
    match /contactMessages/{messageId} {
      allow read, write: if false; // uniquement /api/contact (Admin SDK)
    }
  }
}
